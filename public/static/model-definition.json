  {
    "id": "image-list",
    "fields": [
      {
        "component": "select",
        "name": "listFrom",
        "value": "static",
        "label": "List From",
        "valueType": "string",
        "options": [
          { "name": "Fixed List", "value": "static" },
          { "name": "Child Pages", "value": "children" }
        ]
      },
      {
        "component": "aem-content",
        "name": "pages",
        "label": "Pages",
        "valueType": "string",
        "multi": true,
        "condition": { "===": [{"var" : "listFrom"}, "static"] }
      },
      {
        "component": "aem-content",
        "name": "parentPage",
        "label": "Parent Page",
        "valueType": "string",
        "condition": { "===": [{"var" : "listFrom"}, "children"] }
      }
    ]
  },
  {
    "id": "image-list-item",
    "fields": [
      {
        "component": "text",
        "name": "jcr:title",
        "label": "Title Override",
        "valueType": "string"
      },
      {
        "component": "text",
        "name": "jcr:description",
        "label": "Description Override",
        "valueType": "string"
      }
    ]
  },
  {
    "id": "contentfragment",
    "fields": [
      {
        "component": "aem-content-fragment",
        "name": "fragmentPath",
        "label": "Content Fragment Picker",
        "variationName": "variationName",
        "valueType": "string",
        "validation": {
          "rootPath": "/content/dam"
        }
      }
    ]
  },
  {
    "id": "layout",
    "fields": [
      {
        "component": "select",
        "name": "layoutStyle",
        "label": "Layout",
        "valueType": "string",
        "value": "2col",
        "options": [
          { "name": "2 colonne", "value": "2col" },
          { "name": "3 colonne", "value": "3col" }
        ]
      },
      {
        "component": "select",
        "name": "columnSizing",
        "label": "Sizing",
        "valueType": "string",
        "value": "10-2",
        "options": [
          { "name": "10 / 2", "value": "10-2" },
          { "name": "2 / 10", "value": "2-10" }
        ]
      },
      {
        "component": "select",
        "name": "thirdColumnSize",
        "label": "Third Column Size",
        "valueType": "string",
        "value": "1",
        "condition": { "===": [{"var" : "layoutStyle"}, "3col"] },
        "options": [
          { "name": "1/12", "value": "1" },
          { "name": "2/12", "value": "2" }
        ]
      }
    ]
  }
]
